# UNTESTED starting point for building the Godot game for phones in CI. Copy to .github/workflows/godot-mobile.yml to enable
# (pushing workflow files needs the GitHub App/token to have the "workflows" permission, which is why this lives in docs/).
# What was verified in the cloud sandbox: tools/export_ios.sh generates the Xcode project on Linux. Everything below
# that compiles or signs is unverified.
name: Godot mobile builds
on:
  workflow_dispatch:

env:
  GODOT_VERSION: 4.6.1-stable

jobs:
  tests:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - run: sudo apt-get update && sudo apt-get install -y xvfb libgl1 libxcursor1 libxinerama1 libxi6 libxrandr2
      - run: godot/tools/import.sh
      - run: for t in godot/tests/test_*.gd; do godot/tools/test.sh "tests/$(basename "$t")"; done

  android:
    runs-on: ubuntu-latest        # the hosted image already has the Android SDK and a JDK
    needs: tests
    steps:
      - uses: actions/checkout@v4
      - run: godot/tools/get_godot.sh && ANDROID_HOME="$ANDROID_SDK_ROOT" godot/tools/export_android.sh
      - uses: actions/upload-artifact@v4
        with: { name: android-debug-apk, path: godot/build/android/quantum-teleportar.apk }

  ios:
    runs-on: macos-latest
    needs: tests
    steps:
      - uses: actions/checkout@v4
      - name: Install Godot and export templates
        run: |
          curl -sSL -o godot.zip "https://github.com/godotengine/godot/releases/download/${GODOT_VERSION}/Godot_v${GODOT_VERSION}_macos.universal.zip"
          unzip -q godot.zip -d /Applications
          curl -sSL -o tpl.tpz "https://github.com/godotengine/godot/releases/download/${GODOT_VERSION}/Godot_v${GODOT_VERSION}_export_templates.tpz"
          mkdir -p "$HOME/Library/Application Support/Godot/export_templates/${GODOT_VERSION/-/.}" tpl
          unzip -q tpl.tpz -d tpl && mv tpl/templates/* "$HOME/Library/Application Support/Godot/export_templates/${GODOT_VERSION/-/.}/"
      - name: Generate the Xcode project
        run: |
          mkdir -p godot/build/ios
          /Applications/Godot.app/Contents/MacOS/Godot --headless --path godot --export-debug iOS build/ios/QuantumTeleportar.ipa || true
      - name: Unsigned simulator build (device builds need your Apple team and signing assets)
        run: >
          xcodebuild -project godot/build/ios/QuantumTeleportar.xcodeproj -scheme QuantumTeleportar
          -sdk iphonesimulator -configuration Debug CODE_SIGNING_ALLOWED=NO build

extends RefCounted
## Creature kit B (headless): the Quaternius monsters as rigged enemy bodies (stalker, brute, walker) through CharacterImport with a per-species tint and the enemy triangle budget,
## the flora merged into the street kit (one draw call), the rover and skiff vehicle kinds, the weapon pickup model. Generated by tools/creature_kit.py.
## Run: tools/test.sh tests/test_creature_kit.gd   (tools/import.sh first: new class_name script and glb files)

const Env := preload("res://tests/player_env.gd")
const Stubs := preload("res://tests/enemies_stubs.gd")
const Kit := preload("res://scripts/world/city_kit.gd")
const KitWindow := preload("res://scripts/world/city_kit_window.gd")


class CoverWorld extends Node3D:
	var bodies: Array = []

	func prop_colliders() -> Object:
		return self

	func random_road_point() -> Vector3:
		return Vector3(5.0, 0.0, 0.0)

	func road_point_near(center: Vector3, rmin: float, _rmax: float) -> Vector3:
		return Vector3(center.x + rmin, 0.0, center.z)


func run(host: Node) -> void:
	_bodies()
	_vehicles()
	_pickup()
	_flora_geometry()
	await _enemies(host)
	await _flora_world(host)


func _bodies() -> void:
	var tints := {}
	for role in ["enemy_alien", "enemy_demon", "enemy_bluedemon"]:
		var src := CharacterImport.find_source(role)
		TestLib.check(src != "", "%s: a rigged source is in assets_incoming" % role)
		var r := CharacterImport.load_file(src, role)
		TestLib.check(r["root"] != null and bool(r["ok"]), "%s imports and retargets" % role)
		var info: Dictionary = r["info"]
		TestLib.check(int(info.get("tris", 99999)) <= int(CharacterImport.TRI_BUDGET["enemy"]), "%s within the enemy triangle budget (%d)" % [role, int(info.get("tris", 0))])
		TestLib.check(int(info.get("surfaces", 9)) <= CharacterImport.MAX_SURFACES, "%s keeps at most %d surfaces" % [role, CharacterImport.MAX_SURFACES])
		TestLib.check((info.get("anims", []) as Array).has(&"walk") and (info.get("anims", []) as Array).has(&"death"), "%s has walk and death clips" % role)
		TestLib.check(CharacterRig.find(r["root"]) != null, "%s satisfies the CharacterRig bone contract" % role)
		tints[role] = CharacterImport.ROLE_TINT[role]
		var body := (r["root"] as Node3D).find_child("Body", true, false) as MeshInstance3D
		var sm := body.mesh.surface_get_material(0) as ShaderMaterial
		TestLib.check(sm != null and sm.get_shader_parameter(&"palette_tint") == tints[role], "%s wears its own quantum palette tint" % role)
		(r["root"] as Node).free()
	TestLib.check(tints["enemy_alien"] != tints["enemy_demon"] and tints["enemy_demon"] != tints["enemy_bluedemon"], "three species, three tints")
	for t in CreatureKit.ENEMY_BODIES:
		TestLib.check(EnemyTypes.TYPES[t].get("body", "") == CreatureKit.ENEMY_BODIES[t], "enemy type %s uses the %s body" % [t, CreatureKit.ENEMY_BODIES[t]])


func _vehicles() -> void:
	for kind: StringName in CreatureKit.EXTRA_VEHICLES:
		TestLib.check(VehicleSpecs.SPECS.has(kind) and kind in VehicleSpecs.STREAM_KINDS, "%s is a vehicle kind in the traffic mix" % kind)
		var v := VehicleVisual.new()
		var root := v.build(kind, Color(0.2, 0.9, 1.0))
		TestLib.check(v.uses_model and v.model_name == String(VehicleSpecs.SPECS[kind]["model"]), "%s uses its glb (%s)" % [kind, v.model_name])
		TestLib.check(v.body != null, "%s has a Body mesh for the paint" % kind)
		var tris := CharacterImport.tri_count(v.body.mesh) if v.body != null else 0
		for w in v.wheels:
			tris += CharacterImport.tri_count((w as MeshInstance3D).mesh)
		TestLib.check(tris > 100 and tris <= 2000, "%s triangle count %d within 2000" % [kind, tris])
		TestLib.check(v.wheels.size() == (4 if VehicleSpecs.cls_of(kind) == &"car" else 0), "%s wheels: %d" % [kind, v.wheels.size()])
		root.free()
	TestLib.check(absf(VehicleSpecs.STREAM_WEIGHTS.reduce(func(a, b): return a + b) - 1.0) < 0.001, "stream weights still add up to 1")


func _pickup() -> void:
	var m := Game.load_model("pickup_weapon")
	TestLib.check(m != null, "pickup_weapon model loads")
	if m == null:
		return
	var tris := 0
	for mi in m.find_children("*", "MeshInstance3D", true, false):
		tris += CharacterImport.tri_count((mi as MeshInstance3D).mesh)
	TestLib.check(tris > 50 and tris <= 400, "pickup_weapon %d triangles" % tris)
	m.free()


func _flora_geometry() -> void:
	var budgets := {"Tree": 220, "Plant": 100, "Rock": 80}
	for f in CreatureKit.FAMILIES:
		for v in CreatureKit.VARIANTS:
			var g := CreatureKit.piece(f, v)
			TestLib.check(not g.is_empty() and int(g["count"]) > 0 and int(g["count"]) % 3 == 0, "%s%d geometry present" % [f, v])
			if g.is_empty():
				continue
			TestLib.check(int(g["count"]) / 3 <= int(budgets[f]), "%s%d triangle cap (%d)" % [f, v, int(g["count"]) / 3])
			var n := int(g["count"])
			TestLib.check((g["v"] as PackedVector3Array).size() == n and (g["n"] as PackedVector3Array).size() == n and (g["c"] as PackedColorArray).size() == n and (g["uv2"] as PackedVector2Array).size() == n,
					"%s%d arrays have the street kit layout" % [f, v])
			var aabb := AABB((g["v"] as PackedVector3Array)[0], Vector3.ZERO)
			for p in g["v"] as PackedVector3Array:
				aabb = aabb.expand(p)
			TestLib.check(absf(aabb.position.y) < 0.05 and aabb.size.y > 0.3 and aabb.size.y < 6.0, "%s%d stands on the ground, %.1f m high" % [f, v, aabb.size.y])


func _enemies(host: Node) -> void:
	var e := Env.new()
	await e.setup(host)
	var p: Player = e.p
	p.max_hp = 1.0e6
	var world := CoverWorld.new()
	e.root.add_child(world)
	Game.world = world
	var stub := Stubs.StubMissions.new()
	e.root.add_child(stub)
	Game.missions = stub
	var em := (load("res://scenes/enemy_manager.tscn") as PackedScene).instantiate() as EnemyManager
	e.root.add_child(em)
	em.patrol_groups().clear()
	await e.frames(3)
	for t: StringName in CreatureKit.ENEMY_BODIES:
		var d := em.spawn(t, Vector3(14.0, 0.05, 0.0), false)
		d.set_physics_process(false)
		await e.frames(2)
		var op := d as Operative
		TestLib.check(op != null and op.uses_model and op.rig != null, "%s spawns with the imported rigged body" % t)
		TestLib.check(d.model != null and d.model.name == &"ImportedCharacter", "%s model is the imported character" % t)
		var tris := 0
		var shown := 0
		for mi in DynamicFill._meshes(d.model):
			if mi.visible and mi.mesh != null and mi.layers != 0 and mi.cast_shadow != GeometryInstance3D.SHADOW_CASTING_SETTING_SHADOWS_ONLY:     # not the hidden rest pose, not the shadow proxy
				tris += CharacterImport.tri_count(mi.mesh)
				shown += 1
		TestLib.check(shown >= 1 and shown <= CharacterImport.MAX_SURFACES, "%s draws %d body meshes (at most %d)" % [t, shown, CharacterImport.MAX_SURFACES])
		TestLib.check(tris <= int(CharacterImport.TRI_BUDGET["enemy"]), "%s body %d triangles" % [t, tris])
		em.clear()
	Game.world = null
	Game.missions = null
	await e.teardown()


func _flora_world(host: Node) -> void:
	var city := (load("res://scenes/world.tscn") as PackedScene).instantiate() as City
	host.add_child(city)
	await TestLib.frames(host, 4)
	var kit := city.street_kit() as Kit
	TestLib.check(kit != null, "the street kit is reachable from the city")
	if kit != null:
		var counts := [0, 0, 0]
		for pl in kit.placements:
			var k: int = pl["kind"]
			if k >= Kit.FLORA_TREE and k <= Kit.FLORA_ROCK:
				counts[k - Kit.FLORA_TREE] += 1
		TestLib.check(counts[0] > 0 and counts[1] > 0 and counts[2] > 0, "flora placed round the plazas (trees %d, plants %d, rocks %d)" % [counts[0], counts[1], counts[2]])
		TestLib.check(kit.kind_count[Kit.FLORA_TREE] == counts[0], "kind counts include the flora")
		var win := KitWindow.new()
		win.setup(city, kit, null)
		win.show_all()
		var with_flora := win.triangles
		TestLib.check(with_flora > 0 and win.mesh.get_surface_count() == 1, "the window is still one surface (one draw call) with the flora in it")
		for g_kind in [Kit.FLORA_TREE, Kit.FLORA_PLANT, Kit.FLORA_ROCK]:
			TestLib.check(not kit.geo(g_kind, true, 0, 1).is_empty() and kit.geo(g_kind, false, 0, 1).is_empty(), "%s: near geometry, no far level" % Kit.kind_name(g_kind))
		win.node.queue_free()
	city.queue_free()

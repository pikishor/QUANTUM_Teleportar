class_name WorldMissions
extends RefCounted
## The missions that use the big world (wave 107; docs/DESIGN.md: easy missions, GTA freedom plus COD fights; docs/WORLD_EXPANSION.md): six types the Mission Board adds to its sixteen, each tied
## to a LOCATION and generated by it (the board puts one on offer when the hero is near the site, or now and then from anywhere). A mission is a chapter of campaign steps like every board
## mission (checkpoint at every step, instant retry, objective line, beacon, MissionGuide), built from the old step kinds plus the new ones of WorldSteps:
##   `reach` with `veh` (what the hero must be in: air / heli / plane / boat / ground), `provide` (the vehicle that is left waiting at `provide_at`) and `land` (an aircraft must be down and slow),
##   `gates` (fly or drive through a list of 3D gates in order), `pursuit` (a scripted vehicle runs along a road or a river; stop it, ram it or box it in).
##
##   AIRPORT HEIST      AIRPORT      reach the airport by car, clear the hangar guards, steal the plane on the strip, fly out and land at a field
##   HELI EXTRACTION    a mountain pad   reach the landing zone, hold it against two waves, get in the helicopter, fly it to the city's helipad and land
##   MOUNTAIN PURSUIT   a mountain road  reach the foot of the road in any ground vehicle (a 4x4 waits there), run the smuggler's pickup down the hairpins, secure the cargo at the top
##   RIVER CHASE        HIGHLINE RIVER   get into the boat on the bank, catch the smuggler's boat on the river, follow it to the mouth
##   AIR RACE           a canyon         get in the helicopter on the pad, fly the gates through the gorge (EASTWATER up and back, HIGHLINE down), land on the pad
##   PLANE DELIVERY     AIRPORT      take the cargo plane from the strip, fly it to a field, land, and walk to the buyer
## Pure data and rules, no scene tree. Everything EASY: wide gates, a target that slows when you fall behind, no instant failures, limits that are generous. Pay = base + PAY_PER_M per metre of route.

const TYPES: Array[StringName] = [&"airport_heist", &"heli_extract", &"mountain_pursuit", &"river_chase", &"air_race", &"plane_delivery"]
const PAY_PER_M := 0.1
const NEAR_BOOST := 1100.0              ## the hero this close to a mission's site gets that mission offered for sure
const INJECT_CHANCE := 0.4              ## otherwise a world mission replaces one of the three offers this often
const GATE_R := 20.0                    ## air gate radius (metres, 3D)
const DRIVE_GATE_R := 14.0
const LEAD := 70.0                      ## metres a chase target starts ahead of the hero's start point
const RIVER_CHASE := {"river": 0, "from": 150, "to": 268}

const DEFS := {
	&"airport_heist": {"title": "AIRPORT HEIST", "brief": "Clear the hangar, steal the plane, fly it out and land.", "base": 520, "weight": 3, "glyph": &"door"},
	&"heli_extract": {"title": "HELI EXTRACTION", "brief": "Hold the landing zone, then fly out in the helicopter.", "base": 480, "weight": 3, "glyph": &"person"},
	&"mountain_pursuit": {"title": "MOUNTAIN PURSUIT", "brief": "Run the smuggler down the mountain road in a 4x4.", "base": 440, "weight": 3, "glyph": &"car"},
	&"river_chase": {"title": "RIVER CHASE", "brief": "Catch the smuggler's boat and follow it down the river.", "base": 460, "weight": 3, "glyph": &"car"},
	&"air_race": {"title": "AIR RACE", "brief": "Fly the helicopter through the gates of the canyon.", "base": 420, "weight": 3, "glyph": &"dest"},
	&"plane_delivery": {"title": "PLANE DELIVERY", "brief": "Fly the cargo plane to the field and land it.", "base": 400, "weight": 3, "glyph": &"dest"},
}


static func _s(kind: String, text: String, extra := {}) -> Dictionary:
	var d := {"kind": kind, "text": text, "quiet": true}
	d.merge(extra, true)
	return d


static func _h(a: Vector3, b: Vector3) -> float:
	return Vector2(b.x - a.x, b.z - a.z).length()


## The heading (Vehicle.heading) that looks from `a` toward `b`.
static func heading_to(a: Vector3, b: Vector3) -> float:
	return atan2(-(b.x - a.x), -(b.z - a.z))


# --- where a mission happens ---------------------------------------------------------------------------------------------------

static func _nearest_pad(origin: Vector3) -> Dictionary:
	var best := {}
	var bd := INF
	for d in WorldSites.heli_pads():
		var p: Vector3 = d["pos"]
		var dist := _h(origin, p)
		if dist < bd:
			bd = dist
			best = d
	return best


static func _nearest_canyon(origin: Vector3) -> Dictionary:
	var best := {}
	var bd := INF
	for c in WorldSites.CANYONS:
		var pad := WorldSites.pad(StringName(c["pad"]))
		if pad.is_empty():
			continue
		var d := _h(origin, pad["pos"])
		if d < bd:
			bd = d
			best = c
	return best


static func _nearest_road(origin: Vector3) -> String:
	var best := ""
	var bd := INF
	for rn in WorldSites.CHASE_ROADS:
		var rt := WorldSites.road_route(rn)
		if rt.size() < 8 or WorldSites.length_of(rt) < 420.0:
			continue
		var d := _h(origin, rt[0])
		if d < bd:
			bd = d
			best = rn
	return best


static func _river_put_in(origin: Vector3) -> Vector3:
	return WorldSites.bank_water(int(RIVER_CHASE["river"]), int(RIVER_CHASE["from"]), origin)


## The first place of a mission (what the board shows the distance to), Vector3.INF when the world cannot offer it.
static func site_of(t: StringName, origin: Vector3) -> Vector3:
	match t:
		&"airport_heist", &"plane_delivery":
			var ap := WorldSites.airport()
			return ap["gate"] if t == &"airport_heist" else ap["strip"]
		&"heli_extract":
			var pd := _nearest_pad(origin)
			return pd["pos"] if not pd.is_empty() else Vector3.INF
		&"mountain_pursuit":
			var rn := _nearest_road(origin)
			return WorldSites.road_route(rn)[0] if rn != "" else Vector3.INF
		&"river_chase":
			WaterLayout.ensure()
			return _river_put_in(origin) if WaterLayout.paths.size() > 0 else Vector3.INF
		&"air_race":
			var c := _nearest_canyon(origin)
			return WorldSites.pad(StringName(c["pad"]))["pos"] if not c.is_empty() else Vector3.INF
	return Vector3.INF


static func eligible(t: StringName, origin := Vector3.ZERO) -> bool:
	if not DEFS.has(t):
		return false
	if OutskirtsSites.list.is_empty():
		OutskirtsSites.ensure()
	if OutskirtsSites.list.is_empty():
		return false                                   # a world without the terrain (a stub test world): nothing to offer
	return site_of(t, origin).is_finite()


## The eligible types, nearest site first.
static func available(origin: Vector3) -> Array[StringName]:
	var out: Array[StringName] = []
	for t in TYPES:
		if eligible(t, origin):
			out.append(t)
	out.sort_custom(func(a: StringName, b: StringName) -> bool: return _h(origin, site_of(a, origin)) < _h(origin, site_of(b, origin)))
	return out


## The board's picks with a world mission worked in: one replaces the last pick when the hero stands near a site (always) or now and then (INJECT_CHANCE). Picks that already hold a world type stay.
static func inject(picks: Array[StringName], origin: Vector3, rng: RandomNumberGenerator, banned: Array = []) -> Array[StringName]:
	for p in picks:
		if DEFS.has(p):
			return picks
	var av := available(origin).filter(func(t: StringName) -> bool: return not banned.has(t))
	if av.is_empty() or picks.is_empty():
		return picks
	var chosen: StringName = av[0]
	var near := _h(origin, site_of(chosen, origin)) <= NEAR_BOOST
	if not near:
		if rng.randf() > INJECT_CHANCE:
			return picks
		chosen = av[rng.randi() % av.size()]
	var out: Array[StringName] = picks.duplicate()
	out[out.size() - 1] = chosen
	return out


# --- recipes -------------------------------------------------------------------------------------------------------------------

## The steps of mission `t` at tier `tier` around `origin`; [] when the world has no place for it. Every goal is already placed (`pos`).
static func steps(t: StringName, tier: int, origin: Vector3, r: RandomNumberGenerator) -> Array[Dictionary]:
	var g := clampi(tier, 0, 3)
	var out: Array[Dictionary] = []
	var ap := WorldSites.airport()
	match t:
		&"airport_heist":
			var gate: Vector3 = ap["gate"]
			var strip: Vector3 = ap["strip"]
			var field := WorldSites.far_field(strip, 900.0, &"", r)
			if field.is_empty():
				return out
			var fp: Vector3 = field["pos"]
			out = [
				_s("reach", "GET TO THE AIRPORT", {"pos": gate, "radius": 22.0, "veh": "ground"}),
				_s("kill_target", "CLEAR THE HANGAR GUARDS", {"pos": ap["hangar"], "enemy": "operative", "guards": 1 + g, "hp_mult": 1.2, "name": "HANGAR GUARD"}),
				_s("reach", "STEAL THE PLANE", {"pos": strip, "radius": 16.0, "veh": "plane", "provide": "plane", "provide_at": strip, "provide_h": float(ap["strip_h"])}),
				_s("reach", "FLY OUT AND LAND AT " + String(field["name"]).substr(0, 14), {"pos": fp, "radius": 70.0, "veh": "air", "land": true, "time": 420.0}),
			]
		&"heli_extract":
			var pad := _nearest_pad(origin)
			if pad.is_empty():
				return out
			var lz: Vector3 = pad["pos"]
			var drop: Vector3 = ap["heli"]
			var heli_at := lz + Vector3(9.0, 0.0, 7.0)
			out = [
				_s("reach", "GET TO THE LANDING ZONE", {"pos": lz, "radius": 20.0, "veh": "ground"}),
				_s("defend", "HOLD THE LANDING ZONE", {"pos": lz, "hold": 30.0, "gap": 12.0, "count": 2 + (g / 2), "radius": 30.0}),
				_s("reach", "GET IN THE HELICOPTER", {"pos": heli_at, "radius": 14.0, "veh": "heli", "provide": "heli", "provide_at": heli_at, "provide_h": heading_to(lz, drop)}),
				_s("reach", "FLY TO THE HELIPAD AND LAND", {"pos": drop, "radius": 38.0, "veh": "heli", "land": true, "time": 360.0}),
			]
		&"mountain_pursuit":
			var rn := _nearest_road(origin)
			if rn == "":
				return out
			var route := WorldSites.road_route(rn)
			var start := route[0]
			var pr := PathFollow.new(route)
			var lead := pr.point_at(LEAD)
			var top := route[route.size() - 1]
			out = [
				_s("reach", "GET TO " + rn, {"pos": start, "radius": 16.0, "veh": "ground", "provide": "suv", "provide_at": start + pr.dir_at(0.0).rotated(Vector3.UP, -PI * 0.5) * 5.0, "provide_h": heading_to(start, lead)}),
				_s("pursuit", "RUN DOWN THE SMUGGLER", {"pos": lead, "route": route, "target": "pickup", "hp": 220.0 + 40.0 * g, "cruise": 15.0 + float(g), "catch": 15.0, "time": 300.0, "lead": LEAD}),
				_s("reach", "SECURE THE CARGO", {"pos": top, "radius": 18.0, "veh": "ground"}),
			]
		&"river_chase":
			var ri := int(RIVER_CHASE["river"])
			var put := _river_put_in(origin)
			var route2 := WorldSites.river_route(ri, int(RIVER_CHASE["from"]), int(RIVER_CHASE["to"]))
			if route2.size() < 8:
				return out
			var pr2 := PathFollow.new(route2)
			var lead2 := pr2.point_at(LEAD * 1.1)
			out = [
				_s("reach", "GET IN THE SPEEDBOAT", {"pos": put, "radius": 18.0, "veh": "boat", "provide": "boat", "provide_at": put, "provide_h": heading_to(route2[0], route2[1])}),
				_s("pursuit", "CATCH THE SMUGGLER'S BOAT", {"pos": lead2, "route": route2, "target": "boat", "hp": 200.0 + 30.0 * g, "cruise": 16.0 + float(g), "catch": 17.0, "time": 300.0, "lead": LEAD * 1.1}),
				_s("reach", "FOLLOW IT TO THE RIVER MOUTH", {"pos": route2[route2.size() - 1], "radius": 34.0, "veh": "boat"}),
			]
		&"air_race":
			var c := _nearest_canyon(origin)
			if c.is_empty():
				return out
			var pad2 := WorldSites.pad(StringName(c["pad"]))
			var pp: Vector3 = pad2["pos"]
			var gates := WorldSites.canyon_gates(c, 9, 16.0, 34.0)
			if gates.size() < 4:
				return out
			var heli2 := pp + Vector3(9.0, 0.0, 7.0)
			out = [
				_s("reach", "GET IN THE HELICOPTER", {"pos": heli2, "radius": 16.0, "veh": "heli", "provide": "heli", "provide_at": heli2, "provide_h": heading_to(pp, gates[0])}),
				_s("gates", "FLY THE " + String(c["name"]).substr(0, 20), {"pos": gates[0], "pts": gates, "radius": GATE_R, "veh": "air", "time": 300.0}),
				_s("reach", "LAND ON THE PAD", {"pos": pp, "radius": 34.0, "veh": "heli", "land": true, "time": 240.0}),
			]
		&"plane_delivery":
			var strip2: Vector3 = ap["strip"]
			var field2 := WorldSites.far_field(strip2, 1200.0, &"", r)
			if field2.is_empty():
				return out
			var fp2: Vector3 = field2["pos"]
			var buyer := fp2 + Vector3(26.0, 0.0, 14.0)
			buyer.y = TerrainHeight.height_at(buyer.x, buyer.z)
			out = [
				_s("reach", "GET IN THE CARGO PLANE", {"pos": strip2, "radius": 16.0, "veh": "plane", "provide": "plane", "provide_at": strip2, "provide_h": float(ap["strip_h"])}),
				_s("reach", "FLY TO " + String(field2["name"]).substr(0, 18), {"pos": fp2, "radius": 70.0, "veh": "plane", "land": true, "time": 420.0}),
				_s("reach", "WALK TO THE BUYER", {"pos": buyer, "radius": 9.0}),
			]
	for st: Dictionary in out:
		st["quiet"] = true
	if r != null and not out.is_empty():
		var _roll := r.randf()
	return out


## One finished offer around `origin`: {steps, route_m, pos, title, brief, base, glyph, site}; {} when the world has no place for it.
static func build(t: StringName, tier: int, origin: Vector3, r: RandomNumberGenerator) -> Dictionary:
	if not DEFS.has(t):
		return {}
	var st := steps(t, tier, origin, r)
	if st.is_empty():
		return {}
	var route := 0.0
	var cur := origin
	for s: Dictionary in st:
		var p: Vector3 = s["pos"]
		if String(s["kind"]) == "gates":
			var pts: Array = s["pts"]
			for q: Variant in pts:
				route += _h(cur, q as Vector3)
				cur = q as Vector3
		elif String(s["kind"]) == "pursuit":
			route += WorldSites.length_of(s["route"] as PackedVector3Array)
			cur = (s["route"] as PackedVector3Array)[(s["route"] as PackedVector3Array).size() - 1]
		else:
			route += _h(cur, p)
			cur = p
	var d: Dictionary = DEFS[t]
	return {"steps": st, "route_m": route, "pos": (st[0]["pos"] as Vector3), "title": String(d["title"]), "brief": brief_for(t, st), "base": float(d["base"]), "glyph": d["glyph"], "site": site_of(t, origin)}


## The one line of the card, with the PLACE in it (the steps' own texts name it): "Run the smuggler down SUMMIT ROAD in a 4x4."
static func brief_for(t: StringName, st: Array[Dictionary]) -> String:
	var t0 := String(st[0]["text"])
	var t1 := String(st[1]["text"]) if st.size() > 1 else ""
	match t:
		&"airport_heist":
			return "Steal a plane at %s and fly out." % WorldSites.airport()["name"]
		&"heli_extract":
			var best := ""
			for d in WorldSites.heli_pads():
				if _h(d["pos"], st[0]["pos"]) < 1.0:
					best = String(d["name"])
			return "Hold %s, then fly out by helicopter." % best if best != "" else String(DEFS[t]["brief"])
		&"mountain_pursuit":
			return "Run the smuggler down %s in a 4x4." % t0.trim_prefix("GET TO ")
		&"river_chase":
			return "Catch the smuggler's boat down the river."
		&"air_race":
			return "Fly the helicopter through %s." % t1.trim_prefix("FLY THE ")
		&"plane_delivery":
			return "Fly the cargo plane to %s and land." % t1.trim_prefix("FLY TO ")
	return String(DEFS[t]["brief"])


## Credits: base + PAY_PER_M per metre of route, +10 % per tier, in whole fives.
static func pay_for(base: float, route_m: float, tier_n: int) -> int:
	return maxi(5, int(round((base + PAY_PER_M * route_m) * (1.0 + 0.1 * float(tier_n)) / 5.0)) * 5)

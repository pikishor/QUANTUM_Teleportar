class_name LandKit
extends RefCounted
## The trees of the landscape (wave 112): nine species at three levels of detail plus cross-billboard impostors, generated by tools/landscape/build_land_trees.py into
## assets/models/land_trees.glb (+ assets/textures/land_foliage.webp, land_impostor.webp, land_bark_<species>.webp).
##   <species>_0   LOD0 full (MED, HIGH),  <species>_0l  LOD0 lite (LOW),  <species>_1  LOD1,  "imp"  the shared cross of two quads that every species' far LOD instances
##   LandKit.mesh(name)  / material_for(name)  / tris(name)  / meta(species)   (VegKit delegates the names it does not know to here)
## One ShaderMaterial per species (assets/shaders/land_tree.gdshader, bark + sprite atlas, wind, rain, snow) shared by its three meshes; one material for the impostors
## (assets/shaders/land_impostor.gdshader). Every number of a mesh (height, crown radius, trunk radius, impostor quad size and atlas cell) rides in the GLB as node extras.

const MODEL_PATH := "res://assets/models/land_trees.glb"
const FOLIAGE_PATH := "res://assets/textures/land_foliage.webp"
const IMPOSTOR_PATH := "res://assets/textures/land_impostor.webp"
const BARK_PATH := "res://assets/textures/land_bark_%s.webp"
const TREE_SHADER := "res://assets/shaders/land_tree.gdshader"
const ROCK_SHADER := "res://assets/shaders/land_rock.gdshader"
const IMP_SHADER := "res://assets/shaders/land_impostor.gdshader"
const SPECIES: Array[String] = ["oak", "birch", "poplar", "pine", "fir", "palm", "acacia", "dead", "alien"]

## per species: foliage tint range (multiplies the sprite colours), bark tint, wind sway (metres per metre of height squared at wind 1), translucency, emission
const LOOK := {
	"oak": {"a": Vector3(0.86, 0.95, 0.80), "b": Vector3(1.14, 1.08, 0.90), "bark": Vector3(1.0, 0.96, 0.92), "sway": 0.012, "tr": 0.55},
	"birch": {"a": Vector3(0.92, 1.0, 0.84), "b": Vector3(1.16, 1.10, 0.92), "bark": Vector3(1.05, 1.05, 1.05), "sway": 0.020, "tr": 0.65},
	"poplar": {"a": Vector3(0.90, 0.98, 0.84), "b": Vector3(1.14, 1.08, 0.94), "bark": Vector3(0.95, 0.92, 0.88), "sway": 0.022, "tr": 0.6},
	"pine": {"a": Vector3(0.90, 0.98, 0.92), "b": Vector3(1.12, 1.08, 1.0), "bark": Vector3(1.0, 0.92, 0.86), "sway": 0.010, "tr": 0.35},
	"fir": {"a": Vector3(0.88, 0.96, 0.94), "b": Vector3(1.10, 1.06, 1.02), "bark": Vector3(0.9, 0.88, 0.9), "sway": 0.008, "tr": 0.3},
	"palm": {"a": Vector3(0.92, 1.0, 0.86), "b": Vector3(1.12, 1.08, 0.94), "bark": Vector3(1.0, 0.96, 0.9), "sway": 0.018, "tr": 0.6},
	"acacia": {"a": Vector3(0.92, 0.98, 0.84), "b": Vector3(1.12, 1.06, 0.92), "bark": Vector3(1.0, 0.92, 0.86), "sway": 0.010, "tr": 0.5},
	"dead": {"a": Vector3(0.9, 0.9, 0.9), "b": Vector3(1.1, 1.05, 1.0), "bark": Vector3(1.0, 1.0, 1.0), "sway": 0.004, "tr": 0.2},
	"alien": {"a": Vector3(0.95, 0.95, 1.0), "b": Vector3(1.1, 1.1, 1.1), "bark": Vector3(1.0, 1.0, 1.0), "sway": 0.016, "tr": 0.7, "emit": 1.0},
}

static var _loaded := false
static var _ok := false
static var _meshes := {}                   ## "oak_0" -> Mesh
static var _tris := {}
static var _meta := {}                     ## species -> Dictionary (height, crown_r, trunk_r, quad_w, quad_h, imp_cell, tris_*)
static var _mats := {}                     ## species -> ShaderMaterial
static var _foliage: Texture2D
static var _imp_tex: Texture2D
static var _imp_mesh: ArrayMesh
static var _imp_mat: ShaderMaterial
static var _cells := {}                    ## sprite name -> Rect2i in pixels of the foliage atlas (from the GLB: tools/landscape/foliage.py LAYOUT)
static var _atlas_size := Vector2(2048.0, 1024.0)
static var _cover := {}                    ## ground cover piece name -> {mesh, mat}
static var _rock_mat: ShaderMaterial
const ROCK_LAYERS := [4, 8, 10, 9]         ## layers of the terrain texture array a rock can wear: limestone, strata, dark rock, scree

## ground cover pieces (name -> [sprite cell, kind, width, height, extra]); kinds: "star" = vertical quads crossed round the y axis, "bush" = cards on a hemisphere
const COVER := {
	"g_grass1": ["grass_a", "star", 0.62, 0.85, 3],
	"g_grass2": ["grass_b", "star", 0.66, 0.82, 3],
	"g_dry": ["grass_dry", "star", 0.64, 0.8, 3],
	"g_tall": ["grass_tall", "star", 0.6, 1.15, 3],
	"g_daisy": ["daisy", "star", 0.8, 0.7, 3],
	"g_poppy": ["poppy", "star", 0.5, 0.78, 3],
	"g_lav": ["lavender", "star", 0.5, 0.85, 3],
	"g_clover": ["clover", "star", 0.8, 0.7, 3],
	"g_fern1": ["fern_a", "star", 1.2, 0.95, 3],
	"g_fern2": ["fern_b", "star", 1.3, 1.0, 3],
	"g_reed": ["reed_a", "star", 1.2, 1.7, 3],
	"g_bush1": ["shrub_a", "bush", 1.2, 1.5, 7],
	"g_bush2": ["shrub_b", "bush", 1.3, 1.4, 7],
}
const COVER_LOOK := {
	"g_grass1": {"a": Vector3(0.80, 0.92, 0.66), "b": Vector3(1.12, 1.06, 0.84), "sway": 0.30},
	"g_grass2": {"a": Vector3(0.82, 0.94, 0.68), "b": Vector3(1.10, 1.06, 0.86), "sway": 0.32},
	"g_dry": {"a": Vector3(0.9, 0.9, 0.82), "b": Vector3(1.12, 1.08, 0.96), "sway": 0.30},
	"g_tall": {"a": Vector3(0.82, 0.94, 0.68), "b": Vector3(1.12, 1.06, 0.84), "sway": 0.30},
	"g_daisy": {"a": Vector3(0.95, 0.95, 0.9), "b": Vector3(1.08, 1.06, 1.0), "sway": 0.26},
	"g_poppy": {"a": Vector3(0.95, 0.95, 0.9), "b": Vector3(1.08, 1.06, 1.0), "sway": 0.26},
	"g_lav": {"a": Vector3(0.95, 0.95, 0.95), "b": Vector3(1.08, 1.08, 1.05), "sway": 0.26},
	"g_clover": {"a": Vector3(0.95, 0.95, 0.9), "b": Vector3(1.08, 1.06, 1.0), "sway": 0.26},
	"g_fern1": {"a": Vector3(0.84, 0.96, 0.76), "b": Vector3(1.1, 1.06, 0.92), "sway": 0.16},
	"g_fern2": {"a": Vector3(0.84, 0.96, 0.76), "b": Vector3(1.1, 1.06, 0.92), "sway": 0.16},
	"g_reed": {"a": Vector3(0.84, 0.94, 0.7), "b": Vector3(1.1, 1.06, 0.88), "sway": 0.22},
	"g_bush1": {"a": Vector3(0.84, 0.94, 0.76), "b": Vector3(1.12, 1.06, 0.9), "sway": 0.06},
	"g_bush2": {"a": Vector3(0.84, 0.94, 0.76), "b": Vector3(1.12, 1.06, 0.9), "sway": 0.06},
}


static func _load() -> void:
	if _loaded:
		return
	_loaded = true
	LandClimate.ensure()                     # the shaders read the global `wind`: it must exist before they compile
	var ps := load(MODEL_PATH) as PackedScene
	if ps == null:
		return
	var root := ps.instantiate()
	for n in root.get_children():
		var nm := String(n.name)
		if nm == "meta__atlas":
			var da = n.get_meta("extras", {}) if n.has_meta("extras") else {}
			if da is Dictionary and (da as Dictionary).has("cells"):
				_atlas_size = Vector2(float(da["w"]), float(da["h"]))
				for k in (da["cells"] as Dictionary).keys():
					var r: Array = da["cells"][k]
					_cells[String(k)] = Rect2i(int(r[0]), int(r[1]), int(r[2]), int(r[3]))
		elif nm.begins_with("meta_"):
			var d = n.get_meta("extras", {}) if n.has_meta("extras") else {}
			_meta[nm.substr(5)] = d if d is Dictionary else {}
		elif n is MeshInstance3D and (n as MeshInstance3D).mesh != null:
			var m := (n as MeshInstance3D).mesh
			_meshes[nm] = m
			_tris[nm] = _count(m)
	root.free()
	_foliage = load(FOLIAGE_PATH) as Texture2D
	_imp_tex = load(IMPOSTOR_PATH) as Texture2D
	_imp_mesh = _make_cross()
	_meshes["imp"] = _imp_mesh
	_tris["imp"] = 4
	for i in SPECIES.size():
		var sp: String = SPECIES[i]
		if not _meta.has(sp) or (_meta[sp] as Dictionary).is_empty():
			var m0: Mesh = _meshes.get("%s_0" % sp)
			var hh := m0.get_aabb().size.y if m0 != null else 10.0
			_meta[sp] = {"height": hh, "crown_r": 4.0, "trunk_r": 0.3, "quad_w": hh * 0.8, "quad_h": hh * 1.3, "imp_cell": i * 2}
	_ok = _meshes.has("oak_0") and _meshes.has("fir_0") and _foliage != null and _imp_tex != null


static func available() -> bool:
	_load()
	return _ok


static func species() -> Array[String]:
	return SPECIES


static func has_name(nm: String) -> bool:
	_load()
	return _meshes.has(nm) or (_ok and COVER.has(nm)) or (_ok and nm.length() == 6 and nm.begins_with("rock_") and _meshes.has(nm + "_0"))


static func mesh(nm: String) -> Mesh:
	_load()
	if COVER.has(nm):
		return _cover_piece(nm)["mesh"] if _ok else null
	if nm.length() == 6 and nm.begins_with("rock_") and _meshes.has(nm + "_0"):
		return _meshes[nm + "_0"]
	return _meshes.get(nm)


static func tris(nm: String) -> int:
	_load()
	if COVER.has(nm) and _ok:
		return int(_cover_piece(nm)["tris"])
	return int(_tris.get(nm, 0))


static func meta(sp: String) -> Dictionary:
	_load()
	return _meta.get(sp, {})


static func species_of(nm: String) -> String:
	var i := nm.find("_")
	return nm.substr(0, i) if i > 0 else nm


static func height(sp: String) -> float:
	return float(meta(sp).get("height", 10.0))


static func trunk_radius(sp: String) -> float:
	return float(meta(sp).get("trunk_r", 0.3))


static func impostor_cell(sp: String) -> int:
	return int(meta(sp).get("imp_cell", 0))


static func impostor_size(sp: String) -> Vector2:
	var m := meta(sp)
	return Vector2(float(m.get("quad_w", 8.0)), float(m.get("quad_h", 12.0)))


## The material of a mesh name ("oak_0", "fir_1l", ...) or of the impostors ("imp").
static func material_for(nm: String) -> ShaderMaterial:
	_load()
	if nm == "imp":
		return _impostor_material()
	if COVER.has(nm):
		return _cover_piece(nm)["mat"]
	if nm.begins_with("rock_"):
		return _rock_material()
	var sp := species_of(nm)
	if _mats.has(sp):
		return _mats[sp]
	var mat := ShaderMaterial.new()
	mat.shader = load(TREE_SHADER) as Shader
	mat.set_shader_parameter(&"foliage", _foliage)
	var bark := load(BARK_PATH % sp) as Texture2D
	if bark != null:
		mat.set_shader_parameter(&"bark", bark)
	var look: Dictionary = LOOK.get(sp, LOOK["oak"])
	mat.set_shader_parameter(&"tint_a", look["a"])
	mat.set_shader_parameter(&"tint_b", look["b"])
	mat.set_shader_parameter(&"bark_tint", look["bark"])
	mat.set_shader_parameter(&"sway", float(look["sway"]))
	mat.set_shader_parameter(&"translucency", float(look["tr"]))
	mat.set_shader_parameter(&"height", maxf(height(sp), 2.0))
	if look.has("emit"):
		mat.set_shader_parameter(&"emit_amount", float(look["emit"]))
	_mats[sp] = mat
	return mat


## The rocks' material: the terrain's own texture array, tri-planar (assets/shaders/land_rock.gdshader). Refreshed by set_quality().
static func _rock_material() -> ShaderMaterial:
	if _rock_mat == null:
		_rock_mat = ShaderMaterial.new()
		_rock_mat.shader = load(ROCK_SHADER) as Shader
		_rock_mat.set_shader_parameter(&"flat_col", TerrainTextures.flat_colors())
		set_quality(Game.quality)
	return _rock_mat


static func set_quality(level: int) -> void:
	if _rock_mat == null:
		return
	var arr := TerrainTextures.array(level)
	_rock_mat.set_shader_parameter(&"layers", arr)
	_rock_mat.set_shader_parameter(&"tex_k", 1.0 if arr != null else 0.0)
	_rock_mat.set_shader_parameter(&"detail", 1.0 if level >= 1 else 0.0)


static func _impostor_material() -> ShaderMaterial:
	if _imp_mat == null:
		_imp_mat = ShaderMaterial.new()
		_imp_mat.shader = load(IMP_SHADER) as Shader
		_imp_mat.set_shader_parameter(&"imp", _imp_tex)
	return _imp_mat


static func _count(m: Mesh) -> int:
	var n := 0
	for s in m.get_surface_count():
		var arr := m.surface_get_arrays(s)
		var idx = arr[Mesh.ARRAY_INDEX]
		n += (idx as PackedInt32Array).size() / 3 if idx != null and (idx as PackedInt32Array).size() > 0 else (arr[Mesh.ARRAY_VERTEX] as PackedVector3Array).size() / 3
	return n


## Two crossed unit quads (x in -0.5..0.5, y in 0..1): COLOR.r selects the baked view, UV 0..1 spans the cell.
static func _make_cross() -> ArrayMesh:
	var pos := PackedVector3Array([Vector3(-0.5, 0, 0), Vector3(0.5, 0, 0), Vector3(0.5, 1, 0), Vector3(-0.5, 1, 0), Vector3(0, 0, -0.5), Vector3(0, 0, 0.5), Vector3(0, 1, 0.5), Vector3(0, 1, -0.5)])
	var nrm := PackedVector3Array([Vector3(0, 0, 1), Vector3(0, 0, 1), Vector3(0, 0, 1), Vector3(0, 0, 1), Vector3(1, 0, 0), Vector3(1, 0, 0), Vector3(1, 0, 0), Vector3(1, 0, 0)])
	var uv := PackedVector2Array([Vector2(0, 1), Vector2(1, 1), Vector2(1, 0), Vector2(0, 0), Vector2(0, 1), Vector2(1, 1), Vector2(1, 0), Vector2(0, 0)])
	var col := PackedColorArray([Color(0, 0, 0, 1), Color(0, 0, 0, 1), Color(0, 0, 0, 1), Color(0, 0, 0, 1), Color(1, 0, 0, 1), Color(1, 0, 0, 1), Color(1, 0, 0, 1), Color(1, 0, 0, 1)])
	var idx := PackedInt32Array([0, 1, 2, 0, 2, 3, 4, 5, 6, 4, 6, 7])
	var arr := []
	arr.resize(Mesh.ARRAY_MAX)
	arr[Mesh.ARRAY_VERTEX] = pos
	arr[Mesh.ARRAY_NORMAL] = nrm
	arr[Mesh.ARRAY_TEX_UV] = uv
	arr[Mesh.ARRAY_COLOR] = col
	arr[Mesh.ARRAY_INDEX] = idx
	var m := ArrayMesh.new()
	m.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES, arr)
	m.custom_aabb = AABB(Vector3(-0.5, 0, -0.5), Vector3(1, 1, 1))
	return m


## Adds the kit's meshes to VegKit's tables (names oak_0 ... alien_1, "imp").
static func merge_into(meshes: Dictionary) -> void:
	_load()
	if not _ok:
		return
	for k in _meshes.keys():
		meshes[k] = _meshes[k]
	for k in COVER.keys():
		meshes[k] = mesh(k)
	for shape in ["a", "b", "c", "d"]:                                        # the rocks replace the old low-poly kit pieces of the same name (rock_a ... rock_d: LOD0, rock_x_1: LOD1)
		if _meshes.has("rock_%s_0" % shape):
			meshes["rock_%s" % shape] = _meshes["rock_%s_0" % shape]


# --- ground cover (grass, flowers, ferns, reeds, bushes): small card pieces built here from the foliage atlas ---------------------------------------------------------

static func _cell_uv(sprite: String) -> Rect2:
	var r: Rect2i = _cells.get(sprite, Rect2i(0, 0, 256, 256))
	var inset := 2.0
	return Rect2((float(r.position.x) + inset) / _atlas_size.x, (float(r.position.y) + inset) / _atlas_size.y, (float(r.size.x) - 2.0 * inset) / _atlas_size.x, (float(r.size.y) - 2.0 * inset) / _atlas_size.y)


static func _cover_piece(nm: String) -> Dictionary:
	if _cover.has(nm):
		return _cover[nm]
	var spec: Array = COVER[nm]
	var uvr := _cell_uv(String(spec[0]))
	var w: float = spec[2]
	var h: float = spec[3]
	var n: int = spec[4]
	var pos := PackedVector3Array()
	var nrm := PackedVector3Array()
	var uv := PackedVector2Array()
	var uv2 := PackedVector2Array()
	var col := PackedColorArray()
	var idx := PackedInt32Array()
	var rng := RandomNumberGenerator.new()
	rng.seed = hash(nm)
	if String(spec[1]) == "star":
		for i in n:
			var a := PI * float(i) / float(n) + 0.3
			var rx := Vector3(cos(a), 0.0, sin(a)) * (w * 0.5)
			var base := pos.size()
			var lean := Vector3(-sin(a), 0.0, cos(a)) * 0.0
			for k in 4:
				var top := k >= 2
				var sx := -1.0 if (k == 0 or k == 3) else 1.0
				pos.append(rx * sx + (Vector3(0, h, 0) + lean * h if top else Vector3.ZERO))
				nrm.append(Vector3(0, 1, 0))
				uv.append(Vector2(uvr.position.x + (0.0 if sx < 0.0 else uvr.size.x), uvr.position.y + (0.0 if top else uvr.size.y)))
				uv2.append(Vector2(1.0 if top else 0.0, 0.0))
				var ao := 1.0 if top else 0.55
				col.append(Color(ao, ao, ao, 1.0))
			idx.append_array(PackedInt32Array([base, base + 1, base + 2, base, base + 2, base + 3]))
	else:                                                       # a bush: leaf-mass cards on a hemisphere round a point near the ground
		for i in n:
			var az := TAU * float(i) / float(n) + rng.randf() * 0.5
			var el := 0.15 + 0.85 * float(i % 3) / 2.0
			var dir := Vector3(cos(az) * cos(el * 1.2), sin(el * 1.2), sin(az) * cos(el * 1.2)).normalized()
			var c := Vector3(0, h * 0.42, 0) + dir * h * 0.38
			var right := dir.cross(Vector3.UP)
			if right.length() < 0.2:
				right = Vector3.RIGHT
			right = right.normalized()
			var upv := right.cross(dir).normalized()
			var half := w * 0.5 * rng.randf_range(0.85, 1.1)
			var base2 := pos.size()
			for k in 4:
				var sx2 := -1.0 if (k == 0 or k == 3) else 1.0
				var sy2 := -1.0 if k < 2 else 1.0
				pos.append(c + right * half * sx2 + upv * half * sy2)
				nrm.append((dir + Vector3(0, 0.5, 0)).normalized())
				uv.append(Vector2(uvr.position.x + (0.0 if sx2 < 0.0 else uvr.size.x), uvr.position.y + (uvr.size.y if sy2 < 0.0 else 0.0)))
				uv2.append(Vector2(0.5, 0.0))
				var ao2 := 0.62 + 0.38 * clampf(c.y / h + 0.2, 0.0, 1.0)
				col.append(Color(ao2, ao2, ao2, 1.0))
			idx.append_array(PackedInt32Array([base2, base2 + 1, base2 + 2, base2, base2 + 2, base2 + 3]))
	var arr := []
	arr.resize(Mesh.ARRAY_MAX)
	arr[Mesh.ARRAY_VERTEX] = pos
	arr[Mesh.ARRAY_NORMAL] = nrm
	arr[Mesh.ARRAY_TEX_UV] = uv
	arr[Mesh.ARRAY_TEX_UV2] = uv2
	arr[Mesh.ARRAY_COLOR] = col
	arr[Mesh.ARRAY_INDEX] = idx
	var m := ArrayMesh.new()
	m.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES, arr)
	var mat := ShaderMaterial.new()
	mat.shader = load(TREE_SHADER) as Shader
	mat.set_shader_parameter(&"foliage", _foliage)
	var look: Dictionary = COVER_LOOK.get(nm, COVER_LOOK["g_grass1"])
	mat.set_shader_parameter(&"tint_a", look["a"])
	mat.set_shader_parameter(&"tint_b", look["b"])
	mat.set_shader_parameter(&"sway", float(look["sway"]))
	mat.set_shader_parameter(&"height", maxf(h, 0.3))
	mat.set_shader_parameter(&"flutter", 0.05)
	mat.set_shader_parameter(&"translucency", 0.6)
	mat.set_shader_parameter(&"cutoff", 0.38)
	var piece := {"mesh": m, "mat": mat, "tris": idx.size() / 3}
	_cover[nm] = piece
	return piece
